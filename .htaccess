# Ayuda Monitoring System - web-access rules
#
# This project folder is designed to be copied into a web root as-is, which
# means a few things that must never be reachable over HTTP end up inside it:
# full database dumps, rollback backups, installer scripts, logs, and the
# capstone paperwork. Everything below is blocked from being served, but the
# files stay on disk so the folder can still be copied to another machine.
#
# NOTE: Apache reads this file. PHP's built-in web server (php -S) ignores it,
# so the launcher passes router.php instead, which applies the same rules
# (it refuses sql/, _keep/, logs/, dotfiles and .sql/.log/.bak files).

# --- Never serve the database dumps, migrations or schema -----------------
# sql/ayuda_db_full.sql and the archives under _keep/ contain every row of
# real data (beneficiaries, users, password hashes). Treat them as secrets.
<FilesMatch "\.(sql|dump|bak|log|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RedirectMatch 404 ^/(.*/)?sql/.*$
RedirectMatch 404 ^/(.*/)?_keep/.*$
RedirectMatch 404 ^/(.*/)?logs/.*$

# --- Block dotfiles (.env, .git, editor swap files, etc.) ----------------
RedirectMatch 404 ^/(.*/)\.

# --- Keep the docs / dumps out of directory listings ---------------------
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # sql/, _keep/ and logs/ are data folders, never web pages.
    RewriteRule ^(sql|_keep|logs)/ - [F,L]
    RewriteRule \.(sql|dump|bak|log|ini|env)$ - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>
